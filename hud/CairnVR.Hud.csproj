<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Cairn</GameDir>
    <Core>$(GameDir)\BepInEx\core</Core>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Core)\BepInEx.Core.dll;$(Core)\BepInEx.Unity.IL2CPP.dll;$(Core)\Il2CppInterop.Runtime.dll;$(Interop)\Il2Cppmscorlib.dll;$(Interop)\UnityEngine.CoreModule.dll;$(Interop)\UnityEngine.UIModule.dll;$(Interop)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
</Project>
